{
  "version": 1,
  "sdk_version": "0.23.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "compasseats-mcp",
      "version": "0.1.0",
      "title": "CompassEats"
    },
    "tools": [
      {
        "name": "list_cities",
        "title": "List cities",
        "description": "List every CompassEats city that has at least one charted restaurant or bar. Each entry includes slug, display name, country, coordinates, and venue count. Use this to discover cities before calling get_city.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "country": {
              "type": "string",
              "description": "Optional country name filter (case-insensitive substring match)."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000,
              "description": "Maximum number of cities to return. Defaults to all."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_city",
        "title": "Get city with venues",
        "description": "Fetch a single CompassEats city by slug (e.g. 'tokyo', 'paris', 'new-york') along with its charted venues, ranked by CompassEats prestige score. Use list_cities to discover valid slugs.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "City slug, e.g. 'tokyo' or 'saint-meloir-des-ondes'."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "description": "Maximum venues to return (top-ranked first). Defaults to all."
            }
          },
          "required": [
            "slug"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_regions",
        "title": "List regions",
        "description": "List every CompassEats region (Tuscany, Kansai, Provence, etc.) with slug, display name, country, and venue/city counts.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "country": {
              "type": "string",
              "description": "Optional country name filter (case-insensitive substring match)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_region",
        "title": "Get region",
        "description": "Fetch a single CompassEats region by slug along with its constituent cities (each with venue count). Cities with zero charted venues are filtered out.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "Region slug, e.g. 'tuscany' or 'kansai'."
            }
          },
          "required": [
            "slug"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_venue",
        "title": "Get venue",
        "description": "Fetch full details for a single CompassEats venue by city slug and venue slug: name, type, cuisine, price tier, address, coordinates, website, hours, awards, and blurb.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "city_slug": {
              "type": "string",
              "minLength": 1,
              "description": "City slug, e.g. 'paris'."
            },
            "venue_slug": {
              "type": "string",
              "minLength": 1,
              "description": "Venue slug, e.g. 'le-comptoir-du-relais'."
            }
          },
          "required": [
            "city_slug",
            "venue_slug"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "search_venues",
        "title": "Search venues",
        "description": "Free-text search across all charted CompassEats restaurants and bars. Matches on venue name, city, country, and cuisine tags. Results ranked by CompassEats prestige score.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Search text — venue name, city, country, or cuisine."
            },
            "type": {
              "type": "string",
              "enum": [
                "restaurant",
                "bar"
              ],
              "description": "Optional filter: restaurants only or bars only."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Max results (default 25)."
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_awards",
        "title": "List award sources",
        "description": "List every award / guide CompassEats tracks (Michelin, World's 50 Best, James Beard, Tabelog, La Liste, etc.), including slug, display name, and tier. Use the slug with get_venues_by_award.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_venues_by_award",
        "title": "Get venues by award",
        "description": "List CompassEats venues recognized by a specific award or guide (Michelin, World's 50 Best Restaurants, James Beard, Tabelog, etc.). Use list_awards to discover valid slugs. Results ranked by CompassEats prestige score.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "award_slug": {
              "type": "string",
              "minLength": 1,
              "description": "Award slug, e.g. 'michelin' or 'worlds-50-best-bars'."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "description": "Max results. Defaults to all."
            }
          },
          "required": [
            "award_slug"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
